# скрипты для колонки, Linux и macOS — всегда LF, для Windows — CRLF
*.sh text eol=lf
*.command text eol=lf
device/* text eol=lf
device/assistant/assistantd text eol=lf
device/wakeword/build/wakeword binary
device/wakeword/bin/frida-inject binary
device/wakeword/negatives.bin binary
device/wakeword/lib/audiocapture.jar binary
device/wakeword/frida/*.js text eol=lf
*.bat text eol=crlf
*.png binary
*.stl binary
# install_to_max.ps1 собирается tools/build_installer.py: не считаем его исходником
install_to_max.ps1 linguist-generated
# В архивы GitHub (Download ZIP, исходники релиза, обновление панели из архива) — только то, что нужно для запуска
/tests export-ignore
/docs export-ignore
/.github export-ignore
